@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<CardPreview> Logger

<div class="card-preview" @ref="_host" data-testid="@TestId"></div>
@if (_diagnostics.Length > 0)
{
    <p class="diagnostics" role="status">Browser renderer: @string.Join("; ", _diagnostics)</p>
}

@code {
    [Parameter, EditorRequired] public string Json { get; set; } = "";
    [Parameter] public string TestId { get; set; } = "card-preview";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<CardAction> OnAction { get; set; }
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _renderer;
    private DotNetObjectReference<CardPreview>? _reference;
    private string? _renderedJson;
    private string[] _diagnostics = [];
    private bool _disposed;
    private bool _rendering;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _rendering || _renderedJson == Json) return;
        _rendering = true;
        var json = Json;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/cardPreview.js");
            if (_disposed) { await DisposeAsync(); return; }
            _reference ??= DotNetObjectReference.Create(this);
            _renderer ??= await _module.InvokeAsync<IJSObjectReference>("create", _host, _reference, ReadOnly);
            if (_disposed) { await DisposeAsync(); return; }
            _diagnostics = await _renderer.InvokeAsync<string[]>("render", json);
        }
        catch (JSException error)
        {
            Logger.LogWarning(error, "Card preview failed; retaining the last rendered card");
            _diagnostics = [$"Preview failed: {error.Message}"];
        }
        finally { _rendering = false; }
        _renderedJson = json;
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable]
    public Task HandleAction(string id, string type, string? verb, System.Text.Json.JsonElement data) =>
        _disposed ? Task.CompletedTask : OnAction.InvokeAsync(new CardAction(id, type, verb, data));

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_renderer is not null)
            {
                var renderer = _renderer;
                _renderer = null;
                await renderer.InvokeVoidAsync("dispose");
                await renderer.DisposeAsync();
            }
            if (_module is not null)
            {
                var module = _module;
                _module = null;
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit has already released its DOM and JS references.
        }
        finally { _reference?.Dispose(); }
    }

    public sealed record CardAction(string Id, string Type, string? Verb, System.Text.Json.JsonElement Data);
}
